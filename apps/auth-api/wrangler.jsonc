{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbot-auth-api",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/worker-entry.ts",
  "workers_dev": false,
  "preview_urls": false,
  "cache": {
    "enabled": true,
    "cross_version_cache": false
  },
  "observability": {
    "enabled": false
  },
  "upload_source_maps": false,
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "*/1 * * * *"
    ]
  },
  "routes": [
    {
      "pattern": "api.feitu.dpdns.org",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": [
      "EMAIL_SMTP_PASSWORD",
      "SKILLS_ADMIN_TOKEN",
      "SITE_REPORT_HASH_SECRET",
      "REMOTE_TICKET_PRIVATE_JWK",
      "REMOTE_TICKET_PUBLIC_JWKS",
      "REMOTE_AUTH_WEBHOOK_SECRET"
    ]
  },
  "vars": {
    "AUTH_EXPOSE_DEVELOPMENT_CODE": "false",
    "EMAIL_SMTP_HOST": "smtp.qiye.aliyun.com",
    "EMAIL_SMTP_PORT": "465",
    "EMAIL_REPLY_TO": "",
    "EMAIL_LICENSE_REPLY_TO": "",
    "EMAIL_LICENSE_FROM": "",
    "REMOTE_TICKET_KEY_ID": "self-hosted-1",
    "REMOTE_SIGNAL_URL": "wss://signal.feitu.net.cn/v1/signal",
    "REMOTE_SIGNAL_HOMES": "",
    "REMOTE_SIGNAL_HOME_LOCATIONS": "",
    "REMOTE_SIGNAL_HOME_COUNTRIES": "",
    "REMOTE_AUTH_WEBHOOK_URL": "https://signal.feitu.net.cn/internal/auth-events",
    "REMOTE_AUTH_WEBHOOK_URLS": "",
    "SIGNAL_ENTRY_ZONE_ID": "",
    "HOSTED_SERVERS_ENABLED": "false",
    "HOSTED_SERVERS_ALLOWED_USER_IDS": "",
    "LICENSE_TRIAL_END": "2026-12-01T00:00:00Z",
    "BILLING_COUNTRY_REQUIRED": "false",
    "GITHUB_APP_CLIENT_ID": "",
    "FEEDBACK_WITHDRAWN_REPOSITORY": "",
    "APNS_TEAM_ID": "",
    "APNS_TOPIC": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openbot-auth",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "openbot-avatars"
    },
    {
      "binding": "SKILLS",
      "bucket_name": "openbot-skills"
    },
    {
      "binding": "SITES",
      "bucket_name": "openbot-sites"
    }
  ],
  "ratelimits": [
    {
      "name": "MARKETPLACE_INGRESS_RATE_LIMITER",
      "namespace_id": "2026082701",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "MARKETPLACE_MUTATION_RATE_LIMITER",
      "namespace_id": "2026082702",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "MARKETPLACE_UPLOAD_RATE_LIMITER",
      "namespace_id": "2026082703",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "SITE_REPORT_RATE_LIMITER",
      "namespace_id": "2026083101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "GITHUB_TOKEN_RATE_LIMITER",
      "namespace_id": "2026092911",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "LIVE_ACTIVITY_RATE_LIMITER",
      "namespace_id": "2026092901",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "2026110801",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "env": {
    "preview": {
      "name": "openbot-landing-preview",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "triggers": {
        "crons": []
      },
      "secrets": {
        "required": []
      },
      "vars": {
        "AUTH_EXPOSE_DEVELOPMENT_CODE": "false",
        "EMAIL_SMTP_HOST": "mail.privateemail.com",
        "EMAIL_SMTP_PORT": "465",
        "EMAIL_SMTP_USERNAME": "no_reply@openbot.run",
        "EMAIL_FROM": "no_reply@openbot.run",
        "EMAIL_REPLY_TO": "hello@openbot.run",
        "EMAIL_LICENSE_REPLY_TO": "licenses@openbot.run",
        "EMAIL_LICENSE_FROM": "",
        "SITE_PUBLISH_ENABLED": "false",
        "SITE_COOKIE_ISOLATION_READY": "false",
        "REMOTE_TICKET_KEY_ID": "openbot-remote-1",
        "REMOTE_SIGNAL_URL": "ws://127.0.0.1:8081/v1/signal",
        "REMOTE_SIGNAL_HOMES": "",
        "REMOTE_AUTH_WEBHOOK_URL": "http://127.0.0.1:8081/internal/auth-events",
        "REMOTE_AUTH_WEBHOOK_URLS": "",
        "SIGNAL_ENTRY_ZONE_ID": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "openbot-auth-test",
          "database_id": "38f1a836-6c70-44bb-bbf3-f0bbc5b766b3",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "AVATARS",
          "bucket_name": "openbot-avatars-test"
        },
        {
          "binding": "SKILLS",
          "bucket_name": "openbot-skills-test"
        },
        {
          "binding": "SITES",
          "bucket_name": "openbot-sites-test"
        }
      ],
      "ratelimits": [
        {
          "name": "MARKETPLACE_INGRESS_RATE_LIMITER",
          "namespace_id": "2026082704",
          "simple": {
            "limit": 300,
            "period": 60
          }
        },
        {
          "name": "MARKETPLACE_MUTATION_RATE_LIMITER",
          "namespace_id": "2026082705",
          "simple": {
            "limit": 30,
            "period": 60
          }
        },
        {
          "name": "MARKETPLACE_UPLOAD_RATE_LIMITER",
          "namespace_id": "2026082706",
          "simple": {
            "limit": 5,
            "period": 60
          }
